// =============================================================================
// Executive Summary DAX Measures
// =============================================================================
// These measures operate on the Fact_ExecMatrix table.
// Include QA validation with a 200 bps alert threshold.
// =============================================================================


// -----------------------------------------------------------------------------
// Base measure: sum of values in the exec matrix
// -----------------------------------------------------------------------------

Exec Value :=
SUM ( Fact_ExecMatrix[Value] )


// -----------------------------------------------------------------------------
// Exec metric measures (use in matrix visual or KPI cards)
// -----------------------------------------------------------------------------

Exec Port :=
CALCULATE ( [Exec Value], Fact_ExecMatrix[ExecMetric] = "Port" )

Exec Bench :=
CALCULATE ( [Exec Value], Fact_ExecMatrix[ExecMetric] = "Bench" )

Exec Δ :=
CALCULATE ( [Exec Value], Fact_ExecMatrix[ExecMetric] = "Δ" )


// -----------------------------------------------------------------------------
// QA measures: residual check and 200 bps alert
// -----------------------------------------------------------------------------
// Even though Δ = Total Effect (not arithmetic Port - Bench), the residual
// between (Port - Bench) and Δ should remain small. A drift > 200 bps
// indicates potential data duplication or grain mismatch.
// -----------------------------------------------------------------------------

QA Residual (bps) :=
VAR residual = ( [Exec Port] - [Exec Bench] ) - [Exec Δ]
RETURN 10000 * residual

QA Alert? (200 bps) :=
IF ( ABS([QA Residual (bps)]) > 200, "ALERT", "OK" )
